# Скопируй в файл .env (он в .gitignore) и подставь свои данные.
PORT=3001

# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ?schema=public
DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/vet_clinic?schema=public"

# Секрет для JWT (в продакшене — длинная случайная строка)
JWT_SECRET=замени_на_случайную_строку_32plus

# После migrate:
#   npm run db:seed   — роли, услуги, демо-пользователи и питомцы
#
# Демо-аккаунты (пароль для всех трёх: demo123):
#   client@vetdemo.local   — клиент (есть 3 питомца)
#   doctor@vetdemo.local   — врач (+ запись в veterinarians)
#   admin@vetdemo.local    — администратор
